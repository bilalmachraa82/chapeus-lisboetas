# Chapéus Lisboeta - DevOps Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git (already in .gitignore)

# ============================================================================
# PTISP SERVER
# ============================================================================
PTISP_USER=ptisp
PTISP_HOST=chapeuslisboeta.pt
PTISP_IP=188.93.56.10
PTISP_PATH=/home/ptisp

# ============================================================================
# WORDPRESS & DATABASE
# ============================================================================
WP_PATH=/home/ptisp/public_html
WP_UPLOADS=/home/ptisp/public_html/wp-content/uploads

DB_HOST=localhost
DB_NAME=lisboetas_web
DB_USER=lisboetas
DB_PASSWORD=your_db_password_here
DB_PREFIX=lx_

# MySQL root password (for administrative tasks)
MYSQL_ROOT_PASSWORD=your_root_password_here

# ============================================================================
# AWS S3 BACKUP STORAGE
# ============================================================================
# Create IAM user at: https://console.aws.amazon.com/iam/
# Permissions: S3 read/write access to backup bucket

AWS_ACCESS_KEY_ID=AKIA...your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
S3_BUCKET=chapeus-backups-eu
S3_REGION=eu-west-3

# ============================================================================
# CLOUDFLARE CDN & WAF
# ============================================================================
# Get API token at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:Read, Cache:Purge, DNS:Edit, Analytics:Read

CF_API_TOKEN=your_cloudflare_api_token_here
CF_ZONE_ID=your_cloudflare_zone_id_here
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# ============================================================================
# WOOCOMMERCE API
# ============================================================================
# Create at: WP Admin → WooCommerce → Settings → Advanced → REST API
# Permissions: Read/Write

WC_API_KEY=ck_...your_consumer_key_here
WC_API_SECRET=cs_...your_consumer_secret_here

# ============================================================================
# NOTIFICATIONS (TELEGRAM)
# ============================================================================
# Create bot: Talk to @BotFather on Telegram
# Get chat ID: https://api.telegram.org/bot<TOKEN>/getUpdates

TELEGRAM_BOT_TOKEN=123456789:ABC...your_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================================================
# NOTIFICATIONS (EMAIL)
# ============================================================================
# SMTP provider (recommended: SMTP2GO - 1000 emails/month free)
# https://www.smtp2go.com/

SMTP_HOST=smtp2go.com
SMTP_PORT=587
SMTP_USER=alerts@chapeuslisboeta.pt
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=alerts@chapeuslisboeta.pt
SMTP_FROM_NAME=Chapeus Monitoring

# ============================================================================
# MONITORING (GRAFANA)
# ============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChapeusAdmin2024!
GRAFANA_URL=http://localhost:3000

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
BACKUP_DIR=/home/ptisp/backups
LOCAL_BACKUP_DIR=$HOME/chapeus-backups
BACKUP_RETENTION_DAYS=90
BACKUP_ENCRYPTION_KEY=/home/ptisp/.backup-key

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================
DEPLOY_ENV=production
BLUE_PATH=/home/ptisp/blue
GREEN_PATH=/home/ptisp/green
PUBLIC_PATH=/home/ptisp/public_html

# ============================================================================
# COST OPTIMIZATION
# ============================================================================
MAX_IMAGE_WIDTH=2048
WEBP_QUALITY=85
CDN_CACHE_TTL=2628000
DATABASE_OPTIMIZE_FREQUENCY=weekly

# ============================================================================
# SECURITY
# ============================================================================
# Generate strong password: openssl rand -base64 32
BACKUP_ENCRYPTION_PASSWORD=your_32_char_password_here

# Fail2ban email notifications
FAIL2BAN_SENDER=fail2ban@chapeuslisboeta.pt
FAIL2BAN_DEST=admin@chapeuslisboeta.pt

# ============================================================================
# PERFORMANCE TARGETS
# ============================================================================
TARGET_UPTIME=99.9
TARGET_TTFB_MS=600
TARGET_LCP_MS=2500
TARGET_FID_MS=100
TARGET_CLS=0.1

# ============================================================================
# BUSINESS METRICS
# ============================================================================
# Portuguese market specific
CURRENCY=EUR
TIMEZONE=Europe/Lisbon
LOCALE=pt_PT

# Payment gateways
IFTHENPAY_API_KEY=your_ifthenpay_key_here
CTT_API_KEY=your_ctt_key_here

# ============================================================================
# DEVELOPMENT / STAGING
# ============================================================================
STAGING_URL=https://staging.chapeuslisboeta.pt
BLUE_URL=https://blue.chapeuslisboeta.pt
GREEN_URL=https://green.chapeuslisboeta.pt

# ============================================================================
# MONITORING ENDPOINTS
# ============================================================================
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_URL=http://localhost:9093
GRAFANA_URL=http://localhost:3000

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_DIR=/var/log
LOG_RETENTION_DAYS=30

# ============================================================================
# OPTIONAL: ANALYTICS
# ============================================================================
# Google Analytics
GA_TRACKING_ID=UA-...

# Google Tag Manager
GTM_ID=GTM-...

# ============================================================================
# OPTIONAL: CDN ALTERNATIVES
# ============================================================================
# If using alternative CDN providers

# BunnyCDN (alternative to Cloudflare)
# BUNNYCDN_API_KEY=your_bunnycdn_key_here
# BUNNYCDN_ZONE_NAME=chapeus

# ============================================================================
# OPTIONAL: ADDITIONAL SERVICES
# ============================================================================

# Sentry (error tracking)
# SENTRY_DSN=https://...@sentry.io/...

# New Relic (APM)
# NEW_RELIC_LICENSE_KEY=your_new_relic_key_here

# Datadog (monitoring)
# DATADOG_API_KEY=your_datadog_key_here

# ============================================================================
# NOTES
# ============================================================================
# 1. Generate secure passwords: openssl rand -base64 32
# 2. Never commit this file to git
# 3. Keep backup copy in secure location (password manager)
# 4. Rotate credentials quarterly
# 5. Use environment-specific .env files for staging/production

# ============================================================================
# VERIFICATION CHECKLIST
# ============================================================================
# After filling in all values, verify:
# [ ] Can SSH to PTisp server
# [ ] Can connect to WordPress database
# [ ] AWS S3 credentials work (aws s3 ls)
# [ ] Cloudflare API token works (curl test)
# [ ] WooCommerce API accessible
# [ ] Telegram bot sends messages
# [ ] SMTP sends emails
# [ ] All paths exist on server
# [ ] Backup encryption key generated

# ============================================================================
# QUICK TESTS
# ============================================================================
# Test database connection:
# mysql -h$DB_HOST -u$DB_USER -p$DB_PASSWORD $DB_NAME -e "SELECT 1"

# Test S3 access:
# aws s3 ls s3://$S3_BUCKET/

# Test Cloudflare API:
# curl -X GET "https://api.cloudflare.com/client/v4/user/tokens/verify" \
#   -H "Authorization: Bearer $CF_API_TOKEN"

# Test Telegram bot:
# curl -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/sendMessage" \
#   -d "chat_id=$TELEGRAM_CHAT_ID" -d "text=Test message"

# Test WooCommerce API:
# curl https://chapeuslisboeta.pt/wp-json/wc/v3/system_status \
#   -H "Authorization: Bearer $WC_API_KEY"
